{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.reboot/schemas/run/runner-profiles.schema.json",
  "title": "RunnerProfileRegistryV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_profile", "profiles"],
  "properties": {
    "schema_version": { "const": 1 },
    "default_profile": { "$ref": "#/$defs/profile_id" },
    "profiles": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/profile" } }
  },
  "$defs": {
    "profile_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$" },
    "env_name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
    "profile": { "type": "object", "additionalProperties": false, "required": ["profile_id", "adapter", "executable", "fixed_args", "environment_allow", "environment_set", "start_timeout_seconds", "run_timeout_seconds", "cancel_grace_seconds", "force_kill_after_seconds", "max_stdout_bytes", "max_stderr_bytes"], "properties": { "profile_id": { "$ref": "#/$defs/profile_id" }, "adapter": { "const": "codex_process_v1" }, "executable": { "type": "string", "minLength": 1, "maxLength": 4096, "not": { "pattern": "\\u0000" } }, "fixed_args": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 4096 } }, "environment_allow": { "type": "array", "items": { "$ref": "#/$defs/env_name" } }, "environment_set": { "type": "object", "additionalProperties": { "type": "string" }, "propertyNames": { "$ref": "#/$defs/env_name" } }, "start_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }, "run_timeout_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 }, "cancel_grace_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }, "force_kill_after_seconds": { "type": "integer", "minimum": 0, "maximum": 300 }, "max_stdout_bytes": { "type": "integer", "minimum": 65536, "maximum": 67108864 }, "max_stderr_bytes": { "type": "integer", "minimum": 65536, "maximum": 67108864 } } }
  }
}
