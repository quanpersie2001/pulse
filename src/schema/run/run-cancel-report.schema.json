{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.reboot/schemas/run/run-cancel-report.schema.json",
  "title": "RunCancelReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attempt_id", "state", "already_terminal", "reason_codes"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string" },
    "attempt_id": { "type": "string" },
    "state": { "enum": ["starting", "running", "cancel_requested", "interrupted", "exited", "cancelled", "failed_to_start", "stale_needs_operator"] },
    "already_terminal": { "type": "boolean" },
    "reason_codes": { "type": "array", "items": { "type": "string" } }
  }
}
