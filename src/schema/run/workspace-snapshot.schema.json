{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.reboot/schemas/run/workspace-snapshot.schema.json",
  "title": "WorkspaceSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "workspace_id", "workspace_mode", "base_commit", "head_commit", "diff_base_commit", "operation_state", "cleanliness", "tracked_diff_identity", "untracked_manifest_identity", "status_identity", "snapshot_status", "captured_at", "snapshot_identity"],
  "properties": {
    "schema_version": { "const": 1 },
    "repository_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "workspace_mode": { "enum": ["in_place", "isolated_worktree"] },
    "base_commit": { "type": "string" },
    "head_commit": { "type": "string" },
    "diff_base_commit": { "type": "string" },
    "operation_state": { "enum": ["none", "merge", "rebase", "cherry_pick", "revert", "bisect", "unknown"] },
    "cleanliness": { "enum": ["clean", "dirty", "unknown"] },
    "tracked_diff_identity": { "$ref": "#/$defs/sha256" },
    "untracked_manifest_identity": { "$ref": "#/$defs/sha256" },
    "status_identity": { "$ref": "#/$defs/sha256" },
    "snapshot_status": { "enum": ["complete", "unsupported", "bounded_out"] },
    "captured_at": { "type": "string" },
    "snapshot_identity": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" } }
}
