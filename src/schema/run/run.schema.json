{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.reboot/schemas/run/run.schema.json",
  "title": "RunRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "kind", "state", "subject", "assignment", "workspace", "runner", "current_attempt_id", "attempt_ids", "created_by", "created_at", "updated_at", "last_heartbeat_at", "latest_exit", "latest_workspace_snapshot_identity", "reason_codes", "run_fingerprint"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_.-]+$" },
    "kind": { "const": "single_agent_implementation" },
    "state": { "$ref": "#/$defs/run_state" },
    "subject": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "active_revision", "contract_revision"], "properties": { "kind": { "type": "string" }, "id": { "type": "string" }, "active_revision": { "type": "integer", "minimum": 0 }, "contract_revision": { "type": "integer", "minimum": 0 } } },
    "assignment": { "type": "object", "additionalProperties": false, "required": ["lease_id", "prepared_assignment_id", "prepared_assignment_fingerprint", "packet_fingerprint", "assignee"], "properties": { "lease_id": { "type": "string" }, "prepared_assignment_id": { "type": "string" }, "prepared_assignment_fingerprint": { "$ref": "#/$defs/sha256" }, "packet_fingerprint": { "$ref": "#/$defs/sha256" }, "assignee": { "type": "string" } } },
    "workspace": { "type": "object", "additionalProperties": false, "required": ["workspace_id", "mode", "path", "repository_id", "base_commit"], "properties": { "workspace_id": { "type": "string" }, "mode": { "$ref": "#/$defs/workspace_mode" }, "path": { "type": "string" }, "repository_id": { "type": "string" }, "base_commit": { "type": "string" } } },
    "runner": { "type": "object", "additionalProperties": false, "required": ["adapter", "profile_id", "profile_fingerprint", "resolved_executable_identity", "native_resume_status", "native_thread_id"], "properties": { "adapter": { "const": "codex_process_v1" }, "profile_id": { "type": "string" }, "profile_fingerprint": { "$ref": "#/$defs/sha256" }, "resolved_executable_identity": { "type": ["string", "null"] }, "native_resume_status": { "const": "not_installed" }, "native_thread_id": { "type": ["string", "null"] } } },
    "current_attempt_id": { "type": "string" },
    "attempt_ids": { "type": "array", "items": { "type": "string" } },
    "created_by": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "last_heartbeat_at": { "type": ["string", "null"] },
    "latest_exit": { "anyOf": [{ "$ref": "#/$defs/exit" }, { "type": "null" }] },
    "latest_workspace_snapshot_identity": { "type": ["string", "null"] },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "run_fingerprint": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" },
    "run_state": { "enum": ["starting", "running", "cancel_requested", "interrupted", "exited", "cancelled", "failed_to_start", "stale_needs_operator"] },
    "workspace_mode": { "enum": ["in_place", "isolated_worktree"] },
    "exit": { "type": "object", "additionalProperties": false, "required": ["kind", "code", "signal", "timed_out", "cancelled", "observed_at"], "properties": { "kind": { "enum": ["exited", "cancelled", "timed_out", "interrupted", "failed_to_start"] }, "code": { "type": ["integer", "null"] }, "signal": { "type": ["integer", "null"] }, "timed_out": { "type": "boolean" }, "cancelled": { "type": "boolean" }, "observed_at": { "type": "string" } } }
  }
}
