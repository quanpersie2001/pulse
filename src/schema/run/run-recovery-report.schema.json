{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.reboot/schemas/run/run-recovery-report.schema.json",
  "title": "RunRecoveryReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classifications", "mutations_applied", "reason_codes"],
  "properties": {
    "schema_version": { "const": 1 },
    "classifications": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["run_id", "attempt_id", "classification", "mutation_available", "reason_codes"], "properties": { "run_id": { "type": ["string", "null"] }, "attempt_id": { "type": ["string", "null"] }, "classification": { "type": "string" }, "mutation_available": { "type": "boolean" }, "reason_codes": { "type": "array", "items": { "type": "string" } } } } },
    "mutations_applied": { "type": "array", "items": { "type": "string" } },
    "reason_codes": { "type": "array", "items": { "type": "string" } }
  }
}
