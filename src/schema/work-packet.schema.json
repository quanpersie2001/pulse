{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.reboot/schemas/work-packet.schema.json",
  "title": "WorkPacket",
  "description": "Bounded context for one ready Ticket.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "code", "ticket", "parents", "decisions", "blockers", "related", "docs", "qa", "knowledge", "notes", "rework", "source", "tags_vocabulary", "handoff", "packet_fingerprint"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "work_packet"},
    "code": {"type": "string"},
    "packet_fingerprint": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "ticket": {"$ref": "#/$defs/ticket"},
    "parents": {"type": "array", "items": {"$ref": "#/$defs/parent_summary"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "related": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "docs": {"$ref": "#/$defs/docs"},
    "qa": {"$ref": "#/$defs/qa"},
    "knowledge": {"type": "array", "items": {"$ref": "#/$defs/knowledge"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rework": {"type": "array", "items": {"type": "string"}},
    "source": {"$ref": "#/$defs/source"},
    "tags_vocabulary": {"type": "array", "items": {"type": "string"}},
    "handoff": {"type": "object", "additionalProperties": false, "required": ["commands"], "properties": {"commands": {"type": "array", "items": {"type": "string"}}}}
  },
  "$defs": {
    "raw": {"type": "object", "additionalProperties": false, "required": ["path", "content_hash", "content"], "properties": {"path": {"type": "string"}, "content_hash": {"type": "string"}, "content": {"type": "string"}}},
    "subject": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "role", "title", "revision", "contract_revision", "status", "risk", "materialization", "content_dir"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "role": {"type": "string"}, "title": {"type": "string"}, "revision": {"type": "integer"}, "contract_revision": {"type": "integer"}, "status": {"type": "string"}, "risk": {"type": "string"}, "materialization": {"type": "string"}, "content_dir": {"type": "string"}}},
    "ticket": {"type": "object", "additionalProperties": false, "required": ["node", "brief_hash", "tags", "ticket_md", "plan_md"], "properties": {"node": {"$ref": "#/$defs/subject"}, "brief_hash": {"type": ["string", "null"]}, "tags": {"type": "array", "items": {"type": "string"}}, "ticket_md": {"$ref": "#/$defs/raw"}, "plan_md": {"anyOf": [{"$ref": "#/$defs/raw"}, {"type": "null"}]}}},
    "parent": {"type": "object", "additionalProperties": false, "required": ["relation", "id", "kind", "revision", "contract_revision", "status", "title", "content_dir"], "properties": {"relation": {"type": "string"}, "id": {"type": "string"}, "kind": {"type": "string"}, "revision": {"type": "integer"}, "contract_revision": {"type": "integer"}, "status": {"type": "string"}, "title": {"type": "string"}, "content_dir": {"type": "string"}}},
    "parent_summary": {"type": "object", "additionalProperties": false, "required": ["node", "summary", "approach_md"], "properties": {"node": {"$ref": "#/$defs/parent"}, "summary": {"type": "string"}, "approach_md": {"anyOf": [{"$ref": "#/$defs/raw"}, {"type": "null"}]}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["id", "title", "status", "decision_md"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "string"}, "decision_md": {"anyOf": [{"$ref": "#/$defs/raw"}, {"type": "null"}]}}},
    "blocker": {"type": "object", "additionalProperties": false, "required": ["id", "relation", "title"], "properties": {"id": {"type": "string"}, "relation": {"type": "string"}, "title": {"type": "string"}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["edge_id", "edge_type", "from", "to", "edge_revision", "opposite_id", "opposite_kind", "opposite_status", "opposite_revision", "opposite_title"], "properties": {"edge_id": {"type": "string"}, "edge_type": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}, "edge_revision": {"type": "integer"}, "opposite_id": {"type": "string"}, "opposite_kind": {"type": "string"}, "opposite_status": {"type": "string"}, "opposite_revision": {"type": "integer"}, "opposite_title": {"type": "string"}}},
    "doc": {"type": "object", "additionalProperties": false, "required": ["id", "path", "kind", "status", "owner", "summary", "revision", "content_hash", "reasons"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "kind": {"type": "string"}, "status": {"type": "string"}, "owner": {"type": "string"}, "summary": {"type": "string"}, "revision": {"type": "integer"}, "content_hash": {"type": "string"}, "reasons": {"type": "array", "items": {"type": "string"}}}},
    "excluded": {"type": "object", "additionalProperties": false, "required": ["id", "path", "reason_codes", "replacement"], "properties": {"id": {"type": "string"}, "path": {"type": ["string", "null"]}, "reason_codes": {"type": "array", "items": {"type": "string"}}, "replacement": {"type": ["string", "null"]}}},
    "suggested": {"type": "object", "additionalProperties": false, "required": ["rank", "score_micros", "lexical_score_micros", "section_ref", "heading_path", "line_range", "document_id", "document_hash", "section_hash", "summary", "snippet", "status", "owner", "kind", "matched_fields", "applicability_reasons"], "properties": {"rank": {"type": "integer"}, "score_micros": {"type": "integer"}, "lexical_score_micros": {"type": "integer"}, "section_ref": {"type": "string"}, "heading_path": {"type": "string"}, "line_range": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "integer"}, "end": {"type": "integer"}}}, "document_id": {"type": "string"}, "document_hash": {"type": "string"}, "section_hash": {"type": "string"}, "summary": {"type": "string"}, "snippet": {"type": "string"}, "status": {"type": "string"}, "owner": {"type": "string"}, "kind": {"type": "string"}, "matched_fields": {"type": "array", "items": {"type": "string"}}, "applicability_reasons": {"type": "array", "items": {"type": "string"}}}},
    "docs": {"type": "object", "additionalProperties": false, "required": ["required", "suggested", "write_candidates", "excluded", "read_budget"], "properties": {"required": {"type": "array", "items": {"$ref": "#/$defs/doc"}}, "suggested": {"type": "array", "items": {"$ref": "#/$defs/suggested"}}, "write_candidates": {"type": "array", "items": {"$ref": "#/$defs/doc"}}, "excluded": {"type": "array", "items": {"$ref": "#/$defs/excluded"}}, "read_budget": {"$ref": "#/$defs/read_budget"}}},
    "read_budget": {"type": "object", "additionalProperties": false, "required": ["required_sections", "recommended_initial_sections", "max_initial_lines", "suggestion_limit", "snippet_max_bytes_each"], "properties": {"required_sections": {"type": "integer"}, "recommended_initial_sections": {"type": "integer"}, "max_initial_lines": {"type": "integer"}, "suggestion_limit": {"type": "integer"}, "snippet_max_bytes_each": {"type": "integer"}}},
    "qa": {"type": "object", "additionalProperties": false, "required": ["posture", "cases"], "properties": {"posture": {"type": "string"}, "cases": {"type": "array", "items": {"$ref": "#/$defs/raw"}}}},
    "knowledge": {"type": "object", "additionalProperties": false, "required": ["summary", "why_applicable", "required_checks", "detail_ref"], "properties": {"summary": {"type": "string"}, "why_applicable": {"type": "string"}, "required_checks": {"type": "array", "items": {"type": "string"}}, "detail_ref": {"type": ["string", "null"]}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["repository_id", "commit", "dirty"], "properties": {"repository_id": {"type": "string"}, "commit": {"type": "string"}, "dirty": {"type": "boolean"}}}
  }
}