{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.reboot/schemas/capability-inventory.schema.json",
  "title": "CapabilityInventoryV1",
  "description": "Concrete capability inventory for an assignee. Input to the claim pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "principal": {
      "type": "string"
    },
    "inventory_id": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
