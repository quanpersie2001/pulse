{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.dev/schema/docs/docs-section.schema.json",
  "title": "Pulse Docs Section Record",
  "description": "Derived section/chunk record stored in disposable docs-search sections.jsonl. Canonical prose remains the registered Markdown file; this schema documents the cache/eval contract, not a writable truth source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "section_ref",
    "section_id",
    "document_id",
    "document_revision",
    "path",
    "document_title",
    "heading",
    "heading_path",
    "anchor",
    "ordinal",
    "range",
    "document_content_hash",
    "section_content_hash",
    "summary",
    "authority",
    "lifecycle",
    "owner",
    "kind",
    "domains",
    "aliases",
    "body_indexed",
    "chunk"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "section_ref": { "type": "string", "pattern": "^DOC-[A-Z0-9][A-Z0-9-]{2,63}#[^\\s#@]+(@[1-9][0-9]*)?$" },
    "section_id": { "type": "string" },
    "document_id": { "type": "string", "pattern": "^DOC-[A-Z0-9][A-Z0-9-]{2,63}$" },
    "document_revision": { "type": "integer", "minimum": 1 },
    "path": { "type": "string", "minLength": 1 },
    "document_title": { "type": "string", "minLength": 1 },
    "heading": { "type": "string", "minLength": 1 },
    "heading_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "anchor": { "type": "string", "minLength": 1 },
    "ordinal": { "type": "integer", "minimum": 0 },
    "range": { "$ref": "#/$defs/range" },
    "document_content_hash": { "$ref": "#/$defs/sha256" },
    "section_content_hash": { "$ref": "#/$defs/sha256" },
    "summary": { "type": "string" },
    "authority": { "enum": ["draft", "approved", "informational", "generated"] },
    "lifecycle": { "enum": ["current", "suspected_stale", "stale", "retired", "superseded"] },
    "owner": { "type": "string" },
    "kind": { "enum": ["repository_map", "policy", "product", "architecture", "domain", "operations", "reference", "decision_projection", "generated", "informational"] },
    "domains": { "type": "array", "items": { "type": "string" } },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "body_indexed": { "type": "boolean" },
    "chunk": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/chunk" }] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_line", "end_line"],
      "properties": {
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "total"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
