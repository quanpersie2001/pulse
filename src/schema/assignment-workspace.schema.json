{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.reboot/schemas/assignment-workspace.schema.json",
  "title": "AssignmentWorkspaceRecordV1",
  "description": "Runtime workspace record for a prepared assignment. Local coordination state, not canonical graph node data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "lease_id",
    "prepared_assignment_id",
    "subject",
    "mode",
    "path",
    "repository_id",
    "base_commit",
    "head_commit_at_bind",
    "cleanliness_at_bind",
    "state",
    "created_at",
    "released_at",
    "cleanup"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^wt_[A-Za-z0-9_-]+$"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^lease_[A-Za-z0-9]+$"
    },
    "prepared_assignment_id": {
      "type": "string",
      "pattern": "^pa_[A-Za-z0-9]+$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision"],
      "properties": {
        "kind": { "type": "string" },
        "id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "mode": {
      "type": "string",
      "enum": ["in_place", "isolated_worktree"]
    },
    "path": { "type": "string" },
    "repository_id": { "type": "string" },
    "base_commit": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" },
    "head_commit_at_bind": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" },
    "cleanliness_at_bind": { "type": "string" },
    "state": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "released_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "status"],
      "properties": {
        "policy": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  }
}
