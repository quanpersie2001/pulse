{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.reboot/schemas/assignment-tombstone.schema.json",
  "title": "AssignmentTombstoneV1",
  "description": "Terminal tombstone record for a prepared-assignment lease. Written atomically with live-lease removal during release/recovery. Local coordination state, not canonical graph data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "subject_id",
    "state",
    "recorded_at",
    "actor"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "lease_id": {
      "type": "string",
      "pattern": "^lease_[A-Za-z0-9]+$"
    },
    "subject_id": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": ["released", "expired", "stale_needs_operator"]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
