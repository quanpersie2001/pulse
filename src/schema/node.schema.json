{
  "$defs": {
    "case_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Z0-9](?:[A-Z0-9-]{0,62}[A-Z0-9])?$",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[A-Fa-f0-9]{64}$",
      "type": "string"
    },
    "content_ref": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/content_hash"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "content_hash"
      ],
      "type": "object"
    },
    "contract_item": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "summary": {
          "maxLength": 280,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "summary"
      ],
      "type": "object"
    },
    "decision_work_contract": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "maxLength": 64,
          "pattern": "^BR-[A-Z0-9](?:[A-Z0-9-]{0,59}[A-Z0-9])?$",
          "type": "string"
        },
        "destination_owner": {
          "$ref": "#/$defs/revisioned_work_ref"
        },
        "expected_evidence": {
          "items": {
            "$ref": "#/$defs/expected_evidence"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "expected_output": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "gap_kind": {
          "enum": [
            "fact_gap",
            "intent_gap",
            "tradeoff_gap",
            "fidelity_gap",
            "prerequisite_gap"
          ],
          "type": "string"
        },
        "provenance": {
          "additionalProperties": false,
          "properties": {
            "fog_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/stable_id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "shaping_receipt": {
              "pattern": "^rcpt_.{1,123}$",
              "type": "string"
            }
          },
          "required": [
            "shaping_receipt"
          ],
          "type": "object"
        },
        "question": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "resolution_target": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "enum": [
                "decision",
                "work",
                "evidence"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "destination_owner",
        "branch_id",
        "gap_kind",
        "question",
        "expected_output",
        "provenance"
      ],
      "type": "object"
    },
    "effort_metadata": {
      "additionalProperties": false,
      "properties": {
        "multi_session": {
          "type": "boolean"
        },
        "multiple_dependent_decisions": {
          "type": "boolean"
        },
        "resume_or_audit_continuity": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "expected_evidence": {
      "enum": [
        "focused_test_output",
        "acceptance_mapping",
        "client_contract_inventory",
        "prototype_evidence",
        "research_notes",
        "decision_record",
        "documentation_diff",
        "configuration_diff",
        "data_sample"
      ],
      "type": "string"
    },
    "expected_handoff": {
      "enum": [
        "source_snapshot",
        "acceptance_to_evidence",
        "remaining_risks",
        "documentation_findings",
        "decision_summary",
        "follow_up_work"
      ],
      "type": "string"
    },
    "implementation_contract": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "items": {
            "$ref": "#/$defs/contract_item"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "brief": {
          "anyOf": [
            {
              "$ref": "#/$defs/content_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "code_anchors": {
          "items": {
            "$ref": "#/$defs/surface_ref"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "configuration_anchors": {
          "items": {
            "$ref": "#/$defs/surface_ref"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "current_behavior": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "data_anchors": {
          "items": {
            "$ref": "#/$defs/surface_ref"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "documentation_anchors": {
          "items": {
            "$ref": "#/$defs/surface_ref"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "effort": {
          "$ref": "#/$defs/effort_metadata"
        },
        "expected_evidence": {
          "items": {
            "$ref": "#/$defs/expected_evidence"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "expected_handoff": {
          "items": {
            "$ref": "#/$defs/expected_handoff"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "implementation_freedom": {
          "items": {
            "$ref": "#/$defs/contract_item"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "invariants": {
          "items": {
            "$ref": "#/$defs/contract_item"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "locked",
            "guided",
            "open"
          ],
          "type": "string"
        },
        "objective": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "plan_policy": {
          "enum": [
            "none",
            "worker_optional",
            "required_before_execution"
          ],
          "type": "string"
        },
        "required_changes": {
          "items": {
            "$ref": "#/$defs/contract_item"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "required_decisions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "acceptance_receipt": {
                "$ref": "#/$defs/receipt_ref"
              },
              "contract_revision": {
                "minimum": 1,
                "type": "integer"
              },
              "id": {
                "pattern": "^DEC-[0-9]{3,}$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "contract_revision",
              "acceptance_receipt"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "research_refs": {
          "items": {
            "$ref": "#/$defs/surface_ref"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "additionalProperties": false,
          "properties": {
            "excluded": {
              "items": {
                "maxLength": 280,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            },
            "included": {
              "items": {
                "maxLength": 280,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        },
        "semantic_impact": {
          "enum": [
            "no_behavior_or_public_risk_change",
            "behavior_or_public_risk_change"
          ],
          "type": "string"
        },
        "shared_approach_refs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "content_hash": {
                "$ref": "#/$defs/content_hash"
              },
              "owner": {
                "$ref": "#/$defs/revisioned_work_ref"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "owner",
              "path",
              "content_hash"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "target_behavior": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "verification_profile": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "work_surface": {
          "enum": [
            "code",
            "documentation",
            "configuration",
            "data",
            "research"
          ],
          "type": "string"
        }
      },
      "required": [
        "mode",
        "work_surface",
        "plan_policy",
        "semantic_impact",
        "verification_profile",
        "brief",
        "objective",
        "current_behavior",
        "target_behavior",
        "acceptance"
      ],
      "type": "object"
    },
    "qa_impact": {
      "additionalProperties": false,
      "properties": {
        "affected_case_ids": {
          "items": {
            "$ref": "#/$defs/case_id"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "behavioral_owner": {
          "pattern": "^ST-[0-9]{3,}$",
          "type": [
            "string",
            "null"
          ]
        },
        "posture": {
          "enum": [
            "unknown",
            "required",
            "covered_by_story_close",
            "none"
          ],
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "posture"
      ],
      "type": "object"
    },
    "qa_metadata": {
      "additionalProperties": false,
      "properties": {
        "impact": {
          "$ref": "#/$defs/qa_impact"
        }
      },
      "required": [
        "impact"
      ],
      "type": "object"
    },
    "receipt_ref": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "$ref": "#/$defs/content_hash"
        },
        "id": {
          "pattern": "^rcpt_.{1,123}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "hash"
      ],
      "type": "object"
    },
    "revisioned_work_ref": {
      "additionalProperties": false,
      "properties": {
        "contract_revision": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "contract_revision"
      ],
      "type": "object"
    },
    "shaping_pointer": {
      "additionalProperties": false,
      "properties": {
        "applied_at": {
          "format": "date-time",
          "type": "string"
        },
        "applied_by": {
          "minLength": 1,
          "type": "string"
        },
        "map": {
          "additionalProperties": false,
          "properties": {
            "content_hash": {
              "$ref": "#/$defs/content_hash"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "path",
            "revision",
            "content_hash"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "receipt": {
          "$ref": "#/$defs/receipt_ref"
        }
      },
      "required": [
        "receipt",
        "applied_at",
        "applied_by"
      ],
      "type": "object"
    },
    "stable_id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[A-Z0-9][A-Z0-9-]*[A-Z0-9]$|^[A-Z0-9]{2}$",
      "type": "string"
    },
    "surface_ref": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/content_hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "symbol": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "role": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "role"
              ]
            },
            {
              "properties": {
                "risk": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "risk"
              ]
            },
            {
              "properties": {
                "materialization": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "materialization"
              ]
            },
            {
              "properties": {
                "qa": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "qa"
              ]
            },
            {
              "properties": {
                "implementation": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "implementation"
              ]
            },
            {
              "properties": {
                "decision_work": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "decision_work"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "ticket"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "materialization": {
                "enum": [
                  "unassessed",
                  "R0",
                  "R1",
                  "R2",
                  "R3"
                ],
                "type": "string"
              },
              "qa": {
                "$ref": "#/$defs/qa_metadata"
              },
              "risk": {
                "enum": [
                  "unassessed",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ],
                "type": "string"
              },
              "role": {
                "enum": [
                  "implementation",
                  "decision_work"
                ],
                "type": "string"
              }
            },
            "required": [
              "role",
              "risk",
              "materialization",
              "qa"
            ]
          },
          {
            "not": {
              "allOf": [
                {
                  "properties": {
                    "implementation": {
                      "not": {
                        "type": "null"
                      }
                    }
                  },
                  "required": [
                    "implementation"
                  ]
                },
                {
                  "properties": {
                    "decision_work": {
                      "not": {
                        "type": "null"
                      }
                    }
                  },
                  "required": [
                    "decision_work"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "implementation"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "not": {
                "properties": {
                  "decision_work": {
                    "not": {
                      "type": "null"
                    }
                  }
                },
                "required": [
                  "decision_work"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "decision_work"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "not": {
                "properties": {
                  "implementation": {
                    "not": {
                      "type": "null"
                    }
                  }
                },
                "required": [
                  "implementation"
                ]
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "not": {
          "properties": {
            "shaping": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "shaping"
          ]
        }
      }
    }
  ],
  "properties": {
    "content_dir": {
      "type": "string"
    },
    "contract_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "decision_work": {
      "anyOf": [
        {
          "$ref": "#/$defs/decision_work_contract"
        },
        {
          "type": "null"
        }
      ]
    },
    "documentation": {
      "additionalProperties": false,
      "properties": {
        "impact": {
          "additionalProperties": false,
          "properties": {
            "deferred_to": {
              "items": {
                "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$",
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            },
            "posture": {
              "enum": [
                "unknown",
                "required",
                "none",
                "deferred"
              ],
              "type": "string"
            },
            "rationale": {
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            },
            "required_documents": {
              "items": {
                "pattern": "^DOC-[A-Z0-9][A-Z0-9-]{2,63}$",
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "posture"
          ],
          "type": "object"
        },
        "routing": {
          "additionalProperties": false,
          "properties": {
            "domains": {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            },
            "labels": {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            },
            "paths": {
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        }
      },
      "required": [
        "impact"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "id": {
      "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$",
      "type": "string"
    },
    "implementation": {
      "anyOf": [
        {
          "$ref": "#/$defs/implementation_contract"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "epic",
        "story",
        "ticket",
        "decision"
      ],
      "type": "string"
    },
    "materialization": {
      "enum": [
        "unassessed",
        "R0",
        "R1",
        "R2",
        "R3",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "qa": {
      "anyOf": [
        {
          "$ref": "#/$defs/qa_metadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "risk": {
      "enum": [
        "unassessed",
        "low",
        "medium",
        "high",
        "critical",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "enum": [
        "implementation",
        "decision_work",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "shaping": {
      "anyOf": [
        {
          "$ref": "#/$defs/shaping_pointer"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "shaped",
        "ready",
        "active",
        "verifying",
        "done",
        "rework",
        "blocked",
        "cancelled",
        "superseded"
      ],
      "type": "string"
    },
    "status_reason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "summary"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "revision",
    "contract_revision",
    "title",
    "status",
    "content_dir",
    "created_at",
    "updated_at"
  ],
  "title": "Pulse Work Graph Node",
  "type": "object"
}
