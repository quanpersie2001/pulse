{
  "$defs": {
    "case_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Z0-9](?:[A-Z0-9-]{0,62}[A-Z0-9])?$",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[A-Fa-f0-9]{64}$",
      "type": "string"
    },
    "qa_impact": {
      "additionalProperties": false,
      "properties": {
        "affected_case_ids": {
          "items": {
            "$ref": "#/$defs/case_id"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "behavioral_owner": {
          "pattern": "^ST-[0-9]{3,}$",
          "type": [
            "string",
            "null"
          ]
        },
        "posture": {
          "enum": [
            "unknown",
            "required",
            "covered_by_story_close",
            "none"
          ],
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "posture"
      ],
      "type": "object"
    },
    "qa_metadata": {
      "additionalProperties": false,
      "properties": {
        "impact": {
          "$ref": "#/$defs/qa_impact"
        }
      },
      "required": [
        "impact"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "role": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "role"
              ]
            },
            {
              "properties": {
                "risk": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "risk"
              ]
            },
            {
              "properties": {
                "materialization": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "materialization"
              ]
            },
            {
              "properties": {
                "qa": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "qa"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "ticket"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "materialization": {
                "enum": [
                  "unassessed",
                  "R0",
                  "R1",
                  "R2",
                  "R3"
                ],
                "type": "string"
              },
              "qa": {
                "$ref": "#/$defs/qa_metadata"
              },
              "risk": {
                "enum": [
                  "unassessed",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ],
                "type": "string"
              },
              "role": {
                "enum": [
                  "implementation",
                  "decision_work"
                ],
                "type": "string"
              }
            },
            "required": [
              "role",
              "risk",
              "materialization",
              "qa"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "brief_hash": {
      "anyOf": [
        { "$ref": "#/$defs/content_hash" },
        { "type": "null" }
      ]
    },
    "tags": {
      "items": { "type": "string" },
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "content_dir": {
      "type": "string"
    },
    "contract_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "documentation": {
      "additionalProperties": false,
      "properties": {
        "impact": {
          "additionalProperties": false,
          "properties": {
            "deferred_to": {
              "items": {
                "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$",
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            },
            "posture": {
              "enum": [
                "unknown",
                "required",
                "none",
                "deferred"
              ],
              "type": "string"
            },
            "rationale": {
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            },
            "required_documents": {
              "items": {
                "pattern": "^DOC-[A-Z0-9][A-Z0-9-]{2,63}$",
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "posture"
          ],
          "type": "object"
        },
        "routing": {
          "additionalProperties": false,
          "properties": {
            "domains": {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            },
            "labels": {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            },
            "paths": {
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        }
      },
      "required": [
        "impact"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "id": {
      "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "epic",
        "story",
        "ticket",
        "decision"
      ],
      "type": "string"
    },
    "materialization": {
      "enum": [
        "unassessed",
        "R0",
        "R1",
        "R2",
        "R3",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "qa": {
      "anyOf": [
        {
          "$ref": "#/$defs/qa_metadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "risk": {
      "enum": [
        "unassessed",
        "low",
        "medium",
        "high",
        "critical",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "enum": [
        "implementation",
        "decision_work",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "draft",
        "shaped",
        "ready",
        "active",
        "verifying",
        "done",
        "rework",
        "blocked",
        "cancelled",
        "superseded"
      ],
      "type": "string"
    },
    "status_reason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "summary"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "revision",
    "contract_revision",
    "title",
    "status",
    "content_dir",
    "created_at",
    "updated_at"
  ],
  "title": "Pulse Work Graph Node",
  "type": "object"
}
