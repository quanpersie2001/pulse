{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_dir": {
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "documentation": {
      "additionalProperties": false,
      "properties": {
        "impact": {
          "additionalProperties": false,
          "properties": {
            "deferred_to": {
              "items": {
                "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$",
                "type": "string"
              },
              "type": "array"
            },
            "posture": {
              "enum": [
                "unknown",
                "required",
                "none",
                "deferred"
              ],
              "type": "string"
            },
            "rationale": {
              "minLength": 1,
              "type": "string"
            },
            "required_documents": {
              "items": {
                "pattern": "^DOC-[A-Z0-9][A-Z0-9-]{2,63}$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "posture"
          ],
          "type": "object"
        },
        "routing": {
          "additionalProperties": false,
          "properties": {
            "domains": {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
                "type": "string"
              },
              "type": "array"
            },
            "labels": {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
                "type": "string"
              },
              "type": "array"
            },
            "paths": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "impact"
      ],
      "type": "object"
    },
    "id": {
      "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "epic",
        "story",
        "ticket",
        "decision"
      ],
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "draft",
        "shaped",
        "ready",
        "active",
        "verifying",
        "done",
        "rework",
        "blocked",
        "cancelled",
        "superseded"
      ],
      "type": "string"
    },
    "status_reason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "summary"
      ],
      "type": "object"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "revision",
    "title",
    "status",
    "content_dir",
    "created_at",
    "updated_at"
  ],
  "title": "Pulse Work Graph Node",
  "type": "object"
}
