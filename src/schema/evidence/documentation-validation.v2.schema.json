{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulse documentation validation receipt payload v2",
  "description": "Registry-aware Slice 4 documentation validation payload. Binds canonical document ID, document revision, path and content hash while preserving source/content bindings in the receipt envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_version",
    "documents"
  ],
  "properties": {
    "payload_version": {
      "const": 2
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "document_revision",
          "path",
          "content_hash",
          "result"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^DOC-[A-Z0-9][A-Z0-9-]{2,63}$"
          },
          "document_revision": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "result": {
            "enum": ["passed", "failed", "inconclusive"]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "result"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "result": {"enum": ["passed", "failed", "inconclusive"]},
          "artifact": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "default": []
    }
  }
}
