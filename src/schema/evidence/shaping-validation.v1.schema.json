{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulse shaping validation receipt payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_version",
    "owning_work",
    "materialization",
    "shape_mode",
    "source_posture",
    "approval"
  ],
  "properties": {
    "payload_version": { "const": 1 },
    "owning_work": { "$ref": "#/$defs/work_binding" },
    "materialization": { "enum": ["R0", "R1", "R2", "R3"] },
    "shape_mode": { "enum": ["concise_self_check", "focused_branches", "persisted_map"] },
    "source_posture": { "enum": ["clean_git_commit", "not_required_content_bound"] },
    "destination": { "$ref": "#/$defs/destination" },
    "map": { "$ref": "#/$defs/map" },
    "affected_work": { "type": "array", "items": { "$ref": "#/$defs/work_binding" } },
    "branches": { "type": "array", "items": { "$ref": "#/$defs/branch" } },
    "fog": { "type": "array", "items": { "$ref": "#/$defs/fog" } },
    "out_of_scope": { "type": "array", "items": { "$ref": "#/$defs/out_of_scope" } },
    "resolution_pointers": { "type": "array", "items": { "$ref": "#/$defs/resolution" } },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "reference"],
      "properties": {
        "approved_by": { "$ref": "#/$defs/actor" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "reconciliation": { "$ref": "#/$defs/reconciliation" },
    "remaining_uncertainty": { "type": "array", "items": { "$ref": "#/$defs/remaining_uncertainty" } }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["human", "agent", "system"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "work_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision_observed", "contract_revision"],
      "properties": {
        "id": { "type": "string", "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$" },
        "revision_observed": { "type": "integer", "minimum": 1 },
        "contract_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "exit_conditions"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "scope_boundary": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 280 } },
        "exit_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 280 } }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "content_hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "gap_kind", "criticality", "disposition"],
      "properties": {
        "id": { "type": "string", "pattern": "^BR-[A-Z0-9-]+$" },
        "question": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "gap_kind": { "enum": ["fact_gap", "intent_gap", "tradeoff_gap", "fidelity_gap", "prerequisite_gap"] },
        "criticality": { "enum": ["critical", "non_critical"] },
        "affected_work": { "type": "array", "items": { "type": "string", "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$" } },
        "disposition": { "$ref": "#/$defs/disposition" }
      }
    },
    "disposition": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "resolution"], "properties": { "kind": { "const": "resolved" }, "resolution": { "$ref": "#/$defs/resolution" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": { "kind": { "const": "rejected" }, "reason": { "type": "string", "minLength": 1 }, "reference": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "freedom_id", "reason"], "properties": { "kind": { "const": "delegated" }, "freedom_id": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "reason", "owner", "target_work", "trigger", "non_blocking_for"], "properties": { "kind": { "const": "deferred" }, "reason": { "type": "string", "minLength": 1 }, "owner": { "type": "string", "minLength": 1 }, "target_work": { "type": "string", "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$" }, "trigger": { "type": "string", "minLength": 1 }, "non_blocking_for": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "blocking" }, "linked_decision_work": { "type": "string", "pattern": "^TK-[0-9]{3,}$" } } }
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "gist"],
      "properties": {
        "kind": { "enum": ["decision", "work", "evidence", "content"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision": { "type": "integer", "minimum": 1 },
        "gist": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "fog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "bounds", "why_not_precise", "review", "trigger"],
      "properties": {
        "id": { "type": "string", "pattern": "^FOG-[A-Z0-9-]+$" },
        "statement": { "type": "string", "minLength": 1 },
        "bounds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "why_not_precise": { "type": "string", "minLength": 1 },
        "review": { "const": "bounded_non_blocking" },
        "trigger": { "type": "string", "minLength": 1 },
        "affected_work": { "type": "array", "items": { "type": "string", "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$" } }
      }
    },
    "out_of_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^OOS-[A-Z0-9-]+$" },
        "statement": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supersedes_receipt": { "type": "string", "pattern": "^rcpt_[0-9A-HJKMNP-TV-Z]{26}$" },
        "surfaced_branch_ids": { "type": "array", "items": { "type": "string" } },
        "invalidated_branch_ids": { "type": "array", "items": { "type": "string" } },
        "graduated_fog_ids": { "type": "array", "items": { "type": "string" } },
        "affected_work": { "type": "array", "items": { "type": "string", "pattern": "^(EP|ST|TK|DEC)-[0-9]{3,}$" } }
      }
    },
    "remaining_uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "trigger"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 }
      }
    }
  }
}
