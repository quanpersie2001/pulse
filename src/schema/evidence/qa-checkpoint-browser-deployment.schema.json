{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulse deployment-bound browser QA checkpoint receipt payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_version",
    "qa_scope",
    "story_id",
    "ticket_id",
    "baseline_revision",
    "baseline_content_hash",
    "cases",
    "executor",
    "environment",
    "observations",
    "cleanup_passed"
  ],
  "properties": {
    "payload_version": { "const": 4 },
    "qa_scope": { "enum": ["ticket_checkpoint", "story_close"] },
    "story_id": { "type": "string", "minLength": 1 },
    "ticket_id": { "type": "string", "minLength": 1 },
    "baseline_revision": { "type": "integer", "minimum": 1 },
    "baseline_content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "case_revision", "outcome"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "case_revision": { "type": "integer", "minimum": 1 },
          "outcome": {
            "enum": [
              "passed",
              "product_failure",
              "test_failure",
              "infrastructure_failure",
              "inconclusive",
              "flaky"
            ]
          }
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "capabilities"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "platform", "fixture_revision", "lifecycle"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "fixture_revision": { "type": "string", "minLength": 1 },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "start_passed", "healthcheck_passed", "reset_passed", "cleanup_passed"],
          "properties": {
            "identity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["environment_instance_id", "source_commit", "fixture_revision", "deployment"],
              "properties": {
                "environment_instance_id": { "type": "string", "minLength": 1 },
                "source_commit": { "type": "string", "minLength": 1 },
                "fixture_revision": { "type": "string", "minLength": 1 },
                "deployment": { "$ref": "#/$defs/deployment" }
              }
            },
            "start_passed": { "type": "boolean" },
            "healthcheck_passed": { "type": "boolean" },
            "reset_passed": { "type": "boolean" },
            "cleanup_passed": { "type": "boolean" }
          }
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "base_url", "trace_role", "deployment", "assertions", "console_errors", "network_errors"],
      "properties": {
        "engine": { "enum": ["chromium", "firefox", "webkit"] },
        "base_url": { "type": "string", "pattern": "^https?://\\S+$" },
        "trace_role": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
        "deployment": { "$ref": "#/$defs/deployment" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "kind", "expected", "actual", "passed"],
            "properties": {
              "case_id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "expected": { "type": "string", "minLength": 1 },
              "actual": { "type": "string", "minLength": 1 },
              "passed": { "type": "boolean" }
            }
          }
        },
        "console_errors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "network_errors": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_entry_id", "attempt"],
      "properties": {
        "matrix_entry_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "previous_attempt_receipt_id": { "type": "string", "minLength": 1 },
        "flaky_waiver": { "type": "object" }
      }
    },
    "observations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "cleanup_passed": { "type": "boolean" }
  },
  "$defs": {
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_id", "deployment_id", "base_url"],
      "properties": {
        "build_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "deployment_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "base_url": { "type": "string", "pattern": "^https?://\\S+$" }
      }
    }
  }
}
