{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulse QA checkpoint receipt payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_version",
    "qa_scope",
    "story_id",
    "ticket_id",
    "baseline_revision",
    "baseline_content_hash",
    "cases",
    "executor",
    "observations"
  ],
  "properties": {
    "payload_version": { "const": 1 },
    "qa_scope": { "enum": ["ticket_checkpoint", "story_close"] },
    "story_id": { "type": "string", "minLength": 1 },
    "ticket_id": { "type": "string", "minLength": 1 },
    "baseline_revision": { "type": "integer", "minimum": 1 },
    "baseline_content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "case_revision", "outcome"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "case_revision": { "type": "integer", "minimum": 1 },
          "outcome": {
            "enum": [
              "passed",
              "product_failure",
              "test_failure",
              "infrastructure_failure",
              "inconclusive",
              "flaky"
            ]
          }
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "capabilities"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "observations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
